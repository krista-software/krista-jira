<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="debug">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%-5p %c{1}:%L - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="console"/>
        </Root>
        <!-- Jira extension classes (OrganizationArea, IssueDao, catalog, impl, …) -->
        <Logger name="app.krista.extensions" additivity="false" level="trace">
            <AppenderRef ref="console" />
        </Logger>
        <!-- Shared Atlassian SDK (getAccessToken, OAuth, token store, request authenticator) -->
        <Logger name="app.krista.sdk.atlassian" additivity="false" level="trace">
            <AppenderRef ref="console" />
        </Logger>
    </Loggers>
</Configuration>